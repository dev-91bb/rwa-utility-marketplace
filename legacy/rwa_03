   token.transfer(address(market), amount);\n    }\n\n    function claimEscrow(uint256 escrowId) public {\n        if (market.escrowCount() == 0) return;\n        escrowId = 1 + (escrowId % market.escrowCount());\n        try market.claimEscrow(escrowId) {} catch {}\n    }\n\n    function freezeEscrow(uint256 escrowId) public {\n        if (market.escrowCount() == 0) return;\n        escrowId = 1 + (escrowId % market.escrowCount());\n        try market.freezeEscrow(escrowId) {} catch {}\n    }\n\n    function resolveEscrow(uint256 escrowId, uint256 amount) public {\n        if (market.escrowCount() == 0) return;\n        escrowId = 1 + (escrowId % market.escrowCount());\n        amount = amount % 100_000 ether;\n        try market.resolveEscrow(escrowId, BUYER, amount) {} catch {}\n    }\n\n    function mintTokens(uint256 amount) public {\n        amount = amount % 1_000_000 ether;\n        try token.mint(address(this), amount) { totalMinted += amount; } catch {}\n    }\n\n    function burnTokens(uint256 amount) public {\n        amount = amount % 1_000_000 ether;\n        try token.burn(amount) { totalMinted -= amount; } catch {}\n    }\n\n    // ============ Properties ============\n\n    /// @notice Total supply equals minted minus burned\n    function echidna_supply_eq_minted() public view returns (bool) {\n        return token.totalSupply() == totalMinted;\n    }\n\n    /// @notice Sum of tracked balances <= total supply\n    function echidna_token_conservation() public view returns (bool) {\n        uint256 sum = token.balanceOf(address(this)) +\n                      token.balanceOf(SELLER) +\n                      token.balanceOf(BUYER) +\n                      token.balanceOf(address(market)) +\n                      token.balanceOf(ADMIN_WALLET) +\n                      token.balanceOf(COMPANY_WALLET);\n        return sum <= token.totalSupply();\n    }\n\n    /// @notice Marketplace token balance never underflows (escrow solvency)\n    function echidna_escrow_solvent() public view returns (bool) {\n        return token.balanceOf(address(market)) <= token.totalSupply();\n    }\n\n    /// @notice Sale split: seller_share + admin_share == amount (no dust)\n    function echidna_sale_split_conservation() public view returns (bool) {\n        uint256 amount = 10_000 ether;\n        uint256 sellerShare = (amount * market.saleSellerBps()) / market.BPS();\n        uint256 adminShare = amount - sellerShare;\n        return sellerShare + adminShare == amount;\n    }\n\n    /// @notice Rental split: owner + company + admin == total (no dust)\n    function echidna_rental_split_conservation() public view returns (bool) {\n        uint256 amount = 10_000 ether;\n        uint256 ownerShare = (amount * market.rentalOwnerBps()) / market.BPS();\n        uint256 companyShare = (amount * market.rentalCompanyBps()) / market.BPS();\n        uint256 adminShare = amount - ownerShare - companyShare;\n        return ownerShare + companyShare + adminShare == amount;\n    }\n}\n",
