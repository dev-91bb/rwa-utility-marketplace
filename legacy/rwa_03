                    "Text": "=== Operation 1 Result (Text) ===\n// SPDX-License-Identifier: MIT\npragma solidity ^0.8.20;\n\nimport \"../contracts/token/RWAToken.sol\";\nimport \"../contracts/staking/RWAStaking.sol\";\nimport \"../contracts/nft/RWACertificate.sol\";\nimport \"../contracts/marketplace/RWAMarketplace.sol\";\n\n/// @dev Test-only wrappers that skip _disableInitializers() for Echidna direct deployment\n\ncontract TestRWAToken is\n    ERC20Upgradeable,\n    ERC20BurnableUpgradeable,\n    ERC20PermitUpgradeable,\n    OwnableUpgradeable,\n    UUPSUpgradeable\n{\n    error ZeroAddress();\n    error OnlyProxyAdmin();\n    address private immutable _proxyAdmin;\n\n    constructor(address pa) { _proxyAdmin = pa; }\n\n    function initialize(string memory n, string memory s, uint256 supply, address o) external initializer {\n        if (o == address(0)) revert ZeroAddress();\n        __ERC20_init(n, s);\n        __ERC20Burnable_init();\n        __ERC20Permit_init(n);\n        __Ownable_init(o);\n        __UUPSUpgradeable_init();\n        _mint(o, supply);\n    }\n\n    function mint(address to, uint256 amount) external onlyOwner { _mint(to, amount); }\n    function _authorizeUpgrade(address) internal view override {\n        if (msg.sender != _proxyAdmin) revert OnlyProxyAdmin();\n    }\n}\n\ncontract TestRWAStaking is\n    AccessControlUpgradeable,\n    ReentrancyGuardUpgradeable,\n    PausableUpgradeable,\n    UUPSUpgradeable\n{\n    using SafeERC20 for IERC20;\n\n    error ZeroAddress();\n    error ZeroAmount();\n    error InvalidTier();\n    error StakeNotFound();\n    error OnlyProxyAdmin();\n    error TooEarly();\n\n    struct Stake {\n        uint256 amount;\n        uint256 startTime;\n        uint256 endTime;\n        uint8 tier;\n        bool withdrawn;\n    }\n\n    bytes32 public constant DISTRIBUTOR_ROLE = keccak256(\"DISTRIBUTOR_ROLE\");\n    address private immutable _proxyAdmin;\n    IERC20 public token;\n    address public penaltyReceiver;\n    uint256 public constant MIN_STAKE_DURATION = 1 days;\n    uint256 public constant PENALTY_BPS = 1000;\n    uint256 public constant BPS = 10000;\n    uint256[4] public lockDurations;\n    mapping(address => Stake[]) public stakes;\n    uint256 public totalStaked;\n    uint256 public eligibleStaked;\n    uint256 public rewardPerTokenStored;\n    mapping(address => uint256) public userRewardPerTokenPaid;\n    mapping(address => uint256) public revenueRewards;\n    mapping(address => uint256) public userTotalStaked;\n    mapping(address => uint256) public userEligibleStaked;\n\n    event Staked(address indexed user, uint256 indexed stakeId, uint256 amount, uint8 tier);\n    event Unstaked(address indexed user, uint256 indexed stakeId, uint256 amount, uint256 penalty);\n    event RevenueDistributed(uint256 amount, uint256 newRewardPerToken);\n    event RevenueClaimed(address indexed user, uint256 amount);\n    event EmergencyWithdrawn(address indexed user, uint256 indexed stakeId, uint256 amount);\n\n    constructor(address pa) { _proxyAdmin = pa; }\n\n    function initialize(address t, address a, address pr) external initializer {\n        if (t == address(0) || a == address(0) || pr == address(0)) revert ZeroAddress();\n        __AccessControl_init(); __ReentrancyGuard_init(); __Pausable_init(); __UUPSUpgradeable_init();\n        _grantRole(DEFAULT_ADMIN_ROLE, a);\n        token = IERC20(t); penaltyReceiver = pr;\n        lockDurations[0] = 30 days; lockDurations[1] = 90 days;\n        lockDurations[2] = 180 days; lockDurations[3] = 365 days;\n    }\n\n    modifier updateRevenue(address account) {\n        if (account != address(0)) _promoteEligible(account);\n        if (account != address(0) && eligibleStaked > 0 && userEligibleStaked[account] > 0) {\n            uint256 owed = (userEligibleStaked[account] * (rewardPerTokenStored - userRewardPerTokenPaid[account])) / 1e18;\n            revenueRewards[account] += owed;\n        }\n        userRewardPerTokenPaid[account] = rewardPerTokenStored;\n        _;\n    }\n\n    function _promoteEligible(address account) internal {\n        Stake[] storage s = stakes[account];\n        uint256 total;\n        for (uint256 i = 0; i < s.length; i++) {\n            if (!s[i].withdrawn && block.timestamp >= s[i].startTime + MIN_STAKE_DURATION) total += s[i].amount;\n        }\n        uint256 prev = userEligibleStaked[account];\n        if (total != prev) { userEligibleStaked[account] = total; eligibleStaked = eligibleStaked - prev + total; }\n    }\n\n    function _hasEligibleStake(address account) internal view returns (bool) {\n        Stake[] storage s = stakes[account];\n        for (uint256 i = 0; i < s.length; i++) {\n            if (!s[i].withdrawn && block.timestamp >= s[i].startTime + MIN_STAKE_DURATION) return true;\n        }\n        return false;\n    }\n\n    function stake(uint256 amount, uint8 tier) external nonReentrant whenNotPaused updateRevenue(msg.sender) {\n        if (amount == 0) revert ZeroAmount();\n        if (tier > 3) revert InvalidTier();\n        token.safeTransferFrom(msg.sender, address(this), amount);\n        stakes[msg.sender].push(Stake(amount, block.timestamp, block.timestamp + lockDurations[tier], tier, false));\n        totalStaked += amount; userTotalStaked[msg.sender] += amount;\n        emit Staked(msg.sender, stakes[msg.sender].length - 1, amount, tier);\n    }\n\n    function unstake(uint256 stakeId) external nonReentrant updateRevenue(msg.sender) {\n        Stake storage s = stakes[msg.sender][stakeId];\n        if (s.amount == 0 || s.withdrawn) revert StakeNotFound();\n        if (block.timestamp < s.startTime + MIN_STAKE_DURATION) revert TooEarly();\n        s.withdrawn = true;\n        uint256 amount = s.amount;\n        totalStaked -= amount; userTotalStaked[msg.sender] -= amount;\n        _promoteEligible(msg.sender);\n        uint256 penalty;\n        if (block.timestamp < s.endTime) {\n            penalty = (amount * PENALTY_BPS) / BPS;\n            token.safeTransfer(penaltyReceiver, penalty);\n        }\n        token.safeTransfer(msg.sender, amount - penalty);\n        emit Unstaked(msg.sender, stakeId, amount, penalty);\n    }\n\n    function notifyRewardAmount(uint256 amount) external nonReentrant onlyRole(DISTRIBUTOR_ROLE) {\n        if (amount == 0) revert ZeroAmount();\n        if (eligibleStaked == 0) revert ZeroAmount();\n        token.safeTransferFrom(msg.sender, address(this), amount);\n        rewardPerTokenStored += (amount * 1e18) / eligibleStaked;\n        emit RevenueDistributed(amount, rewardPerTokenStored);\n    }\n\n    function claimRevenue() external nonReentrant updateRevenue(msg.sender) {\n        uint256 reward = revenueRewards[msg.sender];\n        if (reward == 0) revert ZeroAmount();\n        revenueRewards[msg.sender] = 0;\n        token.safeTransfer(msg.sender, reward);\n        emit RevenueClaimed(msg.sender, reward);\n    }\n\n    function isStaking(address user) external view returns (bool) { return userTotalStaked[user] > 0; }\n    function getStakes(address user) external view returns (Stake[] memory) { return stakes[user]; }\n    function _authorizeUpgrade(address) internal view override { if (msg.sender != _proxyAdmin) revert OnlyProxyAdmin(); }\n}\n\ncontract TestRWAMarketplace is\n    AccessControlUpgradeable,\n    ReentrancyGuardUpgradeable,\n    PausableUpgradeable,\n    UUPSUpgradeable\n{\n    using SafeERC20 for IERC20;\n\n    error ZeroAddress();\n    error ZeroAmount();\n    error OnlyProxyAdmin();\n    error EscrowNotReady();\n    error EscrowFrozen();\n    error NothingToClaim();\n    error EscrowNotFrozen();\n    error FeeTooHigh();\n\n    enum EscrowStatus { HELD, CLAIMABLE, FROZEN, RESOLVED }\n\n    struct Escrow {\n        uint256 totalAmount;\n        uint256 createdAt;\n        EscrowStatus status;\n        address[] recipients;\n        uint256[] amounts;\n    }\n\n    uint256 public constant BPS = 10000;\n    uint256 public constant ESCROW_PERIOD = 24 hours;\n\n    address private immutable _proxyAdmin;\n    IERC20 public paymentToken;\n    address public adminWallet;\n    address public companyWallet;\n\n    uint256 public saleSellerBps;\n    uint256 public saleAdminBps;\n    uint256 public rentalOwnerBps;\n    uint256 public rentalCompanyBps;\n    uint256 public rentalAdminBps;\n\n    mapping(uint256 => Escrow) public escrows;\n    uint256 public escrowCount;\n\n    constructor(address pa) { _proxyAdmin = pa; }\n\n    function initialize(address token_, address adminW_, address companyW_, address admin_) external initializer {\n        if (token_ == address(0) || adminW_ == address(0) || companyW_ == address(0) || admin_ == address(0)) revert ZeroAddress();\n        __AccessControl_init(); __ReentrancyGuard_init(); __Pausable_init(); __UUPSUpgradeable_init();\n        _grantRole(DEFAULT_ADMIN_ROLE, admin_);\n        paymentToken = IERC20(token_);\n        adminWallet = adminW_; companyWallet = companyW_;\n        saleSellerBps = 9000; saleAdminBps = 1000;\n        rentalOwnerBps = 7000; rentalCompanyBps = 2000; rentalAdminBps = 1000;\n    }\n\n    /// @dev Simulate a sale deposit into escrow\n    function depositSale(address seller, uint256 amount) external nonReentrant {\n        if (amount == 0) revert ZeroAmount();\n        paymentToken.safeTransferFrom(msg.sender, address(this), amount);\n\n        uint256 id = ++escrowCount;\n        address[] memory r = new address[](2);\n        uint256[] memory a = new uint256[](2);\n        r[0] = seller;      a[0] = (amount * saleSellerBps) / BPS;\n        r[1] = adminWallet;  a[1] = amount - a[0];\n        escrows[id] = Escrow(amount, block.timestamp, EscrowStatus.HELD, r, a);\n    }\n\n    /// @dev Simulate a rental deposit into escrow\n    function depositRental(address owner_, uint256 amount) external nonReentrant {\n        if (amount == 0) revert ZeroAmount();\n        paymentToken.safeTransferFrom(msg.sender, address(this), amount);\n\n        uint256 id