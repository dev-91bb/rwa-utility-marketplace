                    "Text": "// SPDX-License-Identifier: MIT\npragma solidity ^0.8.20;\n\nimport \"forge-std/Test.sol\";\nimport \"@openzeppelin/contracts/proxy/ERC1967/ERC1967Proxy.sol\";\nimport \"../contracts/proxy/HybridProxyAdmin.sol\";\nimport \"../contracts/token/RWAToken.sol\";\nimport \"../contracts/staking/RWAStaking.sol\";\nimport \"../contracts/nft/RWACertificate.sol\";\nimport \"../contracts/marketplace/RWAMarketplace.sol\";\n\ncontract RWASimulation is Test {\n    HybridProxyAdmin proxyAdmin;\n    RWAToken token;\n    RWAStaking staking;\n    RWACertificate cert;\n    RWAMarketplace market;\n\n    address admin = makeAddr(\"admin\");\n    address vendor = makeAddr(\"vendor\");\n    address buyer1 = makeAddr(\"buyer1\");\n    address buyer2 = makeAddr(\"buyer2\");\n    address staker1 = makeAddr(\"staker1\");\n    address tenant = makeAddr(\"tenant\");\n    address marketing = makeAddr(\"marketing\");\n    address adminWallet = makeAddr(\"adminWallet\");\n    address companyWallet = makeAddr(\"company\");\n\n    function setUp() public {\n        vm.startPrank(admin);\n\n        proxyAdmin = new HybridProxyAdmin(admin);\n\n        token = RWAToken(address(new ERC1967Proxy(\n            address(new RWAToken(address(proxyAdmin))),\n            abi.encodeCall(RWAToken.initialize, (\"RWA\", \"RWA\", 10_000_000 ether, admin))\n        )));\n\n        staking = RWAStaking(address(new ERC1967Proxy(\n            address(new RWAStaking(address(proxyAdmin))),\n            abi.encodeCall(RWAStaking.initialize, (address(token), admin, marketing))\n        )));\n\n        cert = RWACertificate(address(new ERC1967Proxy(\n            address(new RWACertificate(address(proxyAdmin))),\n            abi.encodeCall(RWACertificate.initialize, (\"RWAC\", \"RWAC\", admin, address(token), marketing))\n        )));\n\n        market = RWAMarketplace(address(new ERC1967Proxy(\n            address(new RWAMarketplace(address(proxyAdmin))),\n            abi.encodeCall(RWAMarketplace.initialize, (\n                address(token), address(cert), adminWallet, companyWallet, admin\n            ))\n        )));\n\n        cert.grantRole(cert.MINTER_ROLE(), address(market));\n        cert.grantRole(cert.VENDOR_ROLE(), vendor);\n        market.grantRole(market.VENDOR_ROLE(), vendor);\n        cert.setRedemptionFee(\"warehouse\", 200);\n\n        token.transfer(buyer1, 100_000 ether);\n        token.transfer(buyer2, 100_000 ether);\n        token.transfer(staker1, 100_000 ether);\n        token.transfer(tenant, 100_000 ether);\n        token.transfer(address(staking), 500_000 ether);\n\n        vm.stopPrank();\n    }\n\n    // ============================================================\n    //  SCENARIO 1: Primary Sale — vendor lists, buyer purchases\n    // ============================================================\n    function test_Scenario1_PrimarySale() public {\n        console.log(\"=== SCENARIO 1: Primary Sale ===\");\n\n        // Vendor lists new item\n        vm.prank(vendor);\n        market.listNewItem(1000 ether, RWAMarketplace.AssetCategory.DIRECT_SALE, \"gold\", \"GOLD-001\", \"ipfs://gold\", 0);\n\n        // Buyer purchases\n        vm.startPrank(buyer1);\n        token.approve(address(market), type(uint256).max);\n        market.purchaseItem(1);\n        vm.stopPrank();\n\n        assertEq(cert.ownerOf(1), buyer1);\n\n        // Funds escrowed — wait 24h and claim\n        vm.warp(block.timestamp + 24 hours + 1);\n        vm.prank(vendor);\n        market.claimEscrow(1);\n        vm.prank(adminWallet);\n        market.claimEscrow(1);\n\n        assertEq(token.balanceOf(vendor), 900 ether);\n        assertEq(token.balanceOf(adminWallet), 100 ether);\n        console.log(\"  Vendor: 900, Admin: 100\");\n        console.log(\"  PASSED\\n\");\n    }\n\n    // ============================================================\n    //  SCENARIO 2: Stale price — purchase reverts after 6h\n    // ============================================================\n    function test_Scenario2_StalePrice() public {\n        console.log(\"=== SCENARIO 2: Stale Price Reverts ===\");\n\n        vm.prank(vendor);\n        market.listNewItem(1000 ether, RWAMarketplace.AssetCategory.DIRECT_SALE, \"gold\", \"G-2\", \"ipfs://2\", 0);\n\n        // Wait 6h+\n        vm.warp(block.timestamp + 6 hours + 1);\n\n        vm.startPrank(buyer1);\n        token.approve(address(market), type(uint256).max);\n        vm.expectRevert(RWAMarketplace.PriceStale.selector);\n        market.purchaseItem(1);\n        vm.stopPrank();\n        console.log(\"  Purchase reverted: PriceStale\");\n\n        // Vendor refreshes price\n        vm.prank(vendor);\n        market.updatePrice(1, 1000 ether);\n\n        // Now buyer can purchase\n        vm.prank(buyer1);\n        market.purchaseItem(1);\n        assertEq(cert.ownerOf(1), buyer1);\n        console.log(\"  After updatePrice: purchase succeeds\");\n        console.log(\"  PASSED\\n\");\n    }\n\n    // ============================================================\n    //  SCENARIO 3: Rental — full upfront, defined duration\n    // ============================================================\n    function test_Scenario3_Rental() public {\n        console.log(\"=== SCENARIO 3: Rental with Duration ===\");\n\n        // Vendor lists rental: 500 tokens for 30 days\n        vm.prank(vendor);\n        market.listNewItem(500 ether, RWAMarketplace.AssetCategory.RENTAL, \"warehouse\", \"WH-001\", \"ipfs://wh\", 30 days);\n\n        // Tenant starts rental (pays full amount upfront)\n        vm.startPrank(tenant);\n        token.approve(address(market), type(uint256).max);\n        market.startRental(1);\n        vm.stopPrank();\n\n        (,,,uint256 endsAt,) = market.rentals(1);\n        console.log(\"  Rental ends at:\", endsAt);\n\n        // Wait 24h for escrow\n        vm.warp(block.timestamp + 24 hours + 1);\n\n        vm.prank(vendor);\n        market.claimEscrow(1);\n        vm.prank(comp