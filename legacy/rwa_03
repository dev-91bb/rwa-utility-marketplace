                "file_text": "// SPDX-License-Identifier: MIT\npragma solidity ^0.8.20;\n\nimport \"forge-std/Test.sol\";\nimport \"@openzeppelin/contracts/proxy/ERC1967/ERC1967Proxy.sol\";\nimport \"../contracts/proxy/HybridProxyAdmin.sol\";\nimport \"../contracts/token/RWAToken.sol\";\nimport \"../contracts/staking/RWAStaking.sol\";\nimport \"../contracts/nft/RWACertificate.sol\";\nimport \"../contracts/marketplace/RWAMarketplace.sol\";\n\n/**\n * @title RWAFullFlow\n * @notice End-to-end simulation of the entire RWA ecosystem in a single sequential test.\n *\n * Flow:\n *   1. Deploy all contracts behind proxies\n *   2. Configure roles and parameters\n *   3. Vendor lists primary sale item (gold bar)\n *   4. Buyer1 purchases → NFT minted, funds escrowed\n *   5. 24h passes → vendor + admin claim escrow splits\n *   6. Buyer1 lists NFT on secondary market\n *   7. Price goes stale (6h) → Buyer2 purchase reverts\n *   8. Buyer1 refreshes price → Buyer2 purchases\n *   9. Vendor lists rental (warehouse) with 30-day duration\n *  10. Tenant rents → full upfront payment escrowed\n *  11. Seller tries early end → reverts; admin overrides\n *  12. Vendor lists another rental → tenant rents → duration expires → seller ends\n *  13. Escrow dispute: freeze → resolve (partial refund)\n *  14. Escrow dispute: freeze → unfreeze → normal claim\n *  15. NFT redemption: redeem → fulfill → burn\n *  16. NFT dispute: admin disputes → resolves back to Active\n *  17. Staking: user stakes, becomes eligible after 1 day, revenue distributed, claimed\n *  18. Staking: early unstake with 10% penalty\n *  19. Pause/unpause marketplace\n *  20. Rescue accidentally sent tokens\n *  21. Final balance reconciliation\n */\ncontract RWAFullFlow is Test {\n    HybridProxyAdmin proxyAdmin;\n    RWAToken token;\n    RWAStaking staking;\n    RWACertificate cert;\n    RWAMarketplace market;\n\n    address admin = makeAddr(\"admin\");\n    address vendor = makeAddr(\"vendor\");\n    address buyer1 = makeAddr(\"buyer1\");\n    address buyer2 = makeAddr(\"buyer2\");\n    address tenant = makeAddr(\"tenant\");\n    address staker1 = makeAddr(\"staker1\");\n    address marketing = makeAddr(\"marketing\");\n    address adminWallet = makeAddr(\"adminWallet\");\n    address companyWallet = makeAddr(\"companyWallet\");\n\n    uint256 constant INITIAL_SUPPLY = 10_000_000 ether;\n\n    function setUp() public {\n        vm.warp(1000); // deterministic start time\n    }\n\n    function test_FullProcessFlow() public {\n        // ================================================================\n        //  PHASE 1: DEPLOYMENT\n        // ================================================================\n        console.log(\"========================================\");\n        console.log(\"  PHASE 1: DEPLOYMENT\");\n        console.log(\"========================================\");\n\n        vm.startPrank(admin);\n\n        proxyAdmin = new HybridProxyAdmin(admin);\n        console.log(\"  HybridProxyAdmin deployed\");\n\n        token = RWAToken(address(new ERC1967Proxy(\n            address(new RWAToken(address(proxyAdmin))),\n            abi.encodeCall(RWAToken.initialize, (\"RWA\", \"RWA\", INITIAL_SUPPLY, admin))\n        )));\n        console.log(\"  RWAToken deployed, supply:\", token.totalSupply() / 1 ether, \"tokens\");\n\n        staking = RWAStaking(address(new ERC1967Proxy(\n            address(new RWAStaking(address(proxyAdmin))),\n            abi.encodeCall(RWAStaking.initialize, (address(token), admin, marketing))\n        )));\n        console.log(\"  RWAStaking deployed\");\n\n        cert = RWACertificate(address(new ERC1967Proxy(\n            address(new RWACertificate(address(proxyAdmin))),\n            abi.encodeCall(RWACertificate.initialize, (\"RWAC\", \"RWAC\", admin, address(token), marketing))\n        )));\n        console.log(\"  RWACertificate deployed\");\n\n        market = RWAMarketplace(address(new ERC1967Proxy(\n            address(new RWAMarketplace(address(proxyAdmin))),\n            abi.encodeCall(RWAMarketplace.initialize, (\n                address(token), address(cert), adminWallet, companyWallet, admin\n            ))\n        )));\n        console.log(\"  RWAMarketplace deployed\");\n\n        // ================================================================\n        //  PHASE 2: CONFIGURATION\n        // ================================================================\n        console.log(\"\\n========================================\");\n        console.log(\"  PHASE 2: CONFIGURATION\");\n        console.log(\"========================================\");\n\n        cert.grantRole(cert.MINTER_ROLE(), address(market));\n        console.log(\"  Marketplace granted MINTER_ROLE on Certificate\");\n\n        cert.grantRole(cert.VENDOR_ROLE(), vendor);\n        console.log(\"  Vendor granted VENDOR_ROLE on Certificate\");\n\n        market.grantRole(market.VENDOR_ROLE(), vendor);\n        console.log(\"  Vendor granted VENDOR_ROLE on Marketplace\");\n\n        staking.grantRole(staking.DISTRIBUTOR_ROLE(), admin);\n        console.log(\"  Admin granted DISTRIBUTOR_ROLE on Staking\");\n\n        cert.setRedemptionFee(\"gold\", 500);     // 5%\n        cert.setRedemptionFee(\"warehouse\", 200); // 2%\n        console.log(\"  Redemption fees: gold=5%, warehouse=2%\");\n\n        // Fund participants\n        token.transfer(buyer1, 200_000 ether);\n        token.transfer(buyer2, 200_000 ether);\n        token.transfer(tenant, 200_000 ether);\n        token.transfer(staker1, 200_000 ether);\n        token.transfer(address(staking), 1_000_000 ether);\n        console.log(\"  Funded: buyer1, buyer2, tenant, staker1 @ 200k each\");\n        console.log(\"  Staking contract funded with 1M tokens for rewards\");\n\n        vm.stopPrank();\n\n        // ================================================================\n        //  PHASE 3: PRIMARY SALE (Gold Bar)\n        // ================================================================\n        console.log(\"\\n========================================\");\n        console.log(\"  PHASE 3: PRIMARY SALE\");\n        console.log(\"========================================\");\n\n        vm.prank(vendor);\n        market.listNewItem(\n            5000 ether,\n            RWAMarketplace.AssetCategory.DIRECT_SALE,\n            \"gold\", \"GOLD-001\", \"ipfs://gold-bar-001\", 0\n        );\n        console.log(\"  Vendor listed: Gold Bar GOLD-001 @ 5000 tokens (listingId=1)\");\n\n        vm.startPrank(buyer1);\n        token.approve(address(market), type(uint256).max);\n        market.purchaseItem(1);\n        vm.stopPrank();\n\n        assertEq(cert.ownerOf(1), buyer1);\n        console.log(\"  Buyer1 purchased -> NFT #1 minted to buyer1\");\n        console.log(\"  Buyer1 balance:\", token.balanceOf(buyer1) / 1 ether, \"tokens\");\n        console.log(\"  Escrow holds:\", token.balanceOf(address(market)) / 1 ether, \"tokens\");\n\n        // Wait 24h and claim\n        vm.warp(block.timestamp + 24 hours + 1);\n        console.log(\"  --- 24 hours passed ---\");\n\n        vm.prank(vendor);\n        market.claimEscrow(1);\n        console.log(\"  Vendor claimed:\", token.balanceOf(vendor) / 1 ether, \"tokens (90% = 4500)\");\n\n        vm.prank(adminWallet);\n        market.claimEscrow(1);\n        console.log(\"  AdminWallet claimed:\", token.balanceOf(adminWallet) / 1 ether, \"tokens (10% = 500)\");\n\n        assertEq(token.balanceOf(vendor), 4500 ether);\n        assertEq(token.balanceOf(adminWallet), 500 ether);\n\n        // ================================================================\n        //  PHASE 4: SECONDARY SALE (Buyer1 resells to Buyer2)\n        // ================================================================\n        console.log(\"\\n========================================\");\n        console.log(\"  PHASE 4: SECONDARY SALE\");\n        console.log(\"========================================\");\n\n        vm.startPrank(buyer1);\n        cert.approve(address(market), 1);\n        market.listExistingItem(1, 8000 ether, RWAMarketplace.AssetCategory.DIRECT_SALE, 0);\n        vm.stopPrank();\n        console.log(\"  Buyer1 listed NFT #1 for resale @ 8000 tokens (listingId=2)\");\n\n        // ================================================================\n        //  PHASE 5: STALE PRICE -> REFRESH -> PURCHASE\n        // ================================================================\n        console.log(\"\\n========================================\");\n        console.log(\"  PHASE 5: STALE PRICE HANDLING\");\n        console.log(\"========================================\");\n\n        vm.warp(block.timestamp + 6 hours + 1);\n        console.log(\"  --- 6+ hours passed, price is stale ---\");\n\n        vm.startPrank(buyer2);\n        token.approve(address(market), type(uint256).max);\n        vm.expectRevert(RWAMarketplace.PriceStale.selector);\n        market.purchaseItem(2);\n        vm.stopPrank();\n        console.log(\"  Buyer2 purchase REVERTED: PriceStale\");\n\n        vm.prank(buyer1);\n        market.updatePrice(2, 7500 ether);\n        console.log(\"  Buyer1 refreshed price to 7500 tokens\");\n\n        vm.prank(buyer2);\n        market.purchaseItem(2);\n        assertEq(cert.ownerOf(1), buyer2);\n        console.log(\"  Buyer2 purchased NFT #1 for 7500 tokens\");\n        console.log(\"  NFT #1 now owned by buyer2\");\n\n        // Claim secondary sale escrow\n        vm.warp(block.timestamp + 24 hours + 1);\n        uint256 b1Before = token.balanceOf(buyer1);\n        vm.prank(buyer1);\n        market.claimEscrow(2);\n        uint256 sellerGot = token.balanceOf(buyer1) - b1Before;\n        console.log(\"  Buyer1 (seller) claimed:\", sellerGot / 1 ether, \"tokens (90% of 7500 = 6750)\");\n        assertEq(sellerGot, 6750 ether);\n\n        vm.prank(adminWallet);\n        market.claimEscrow(2);\n        console.log(\"  AdminWallet total:\", token.balanceOf(adminWallet) / 1 ether, \"tokens\");\n\n        // ================================================================\n        //  PHASE 6: RENTAL (Warehouse, 30 days)\n        // ================================================================\n        console.log(\"\\n========================================\");\n        console.log(\"  PHASE 6: RENTAL\");\n        console.log(\"========================================\");\n\n        vm.prank(vendor);\n        market.listNewItem(\n            1000 ether,\n            RWAMarketplace.AssetCategory.RENTAL,\n            \"warehouse\", \"WH-001\", \"ipfs://warehouse-001\", 30 days\n        );\n        console.log(\"  Vendor listed: Warehouse WH-001 @ 1000 tokens, 30-day rental (listingId=3)\");\n\n        vm.startPrank(tenant);\n        token.approve(address(market), type(uint256).max);\n        market.startRental(3);\n        vm.stopPrank();\n\n        (address rTenant,, uint256 startedAt, uint256 endsAt, bool active) = market.rentals(3);\n        console.log(\"  Tenant rented: paid 1000 tokens upfront\");\n        console.log(\"  Rental active:\", active);\n        console.log(\"  Duration: 30 days, ends at:\", endsAt);\n\n        // Seller tries to end early\n        vm.prank(vendor);\n        vm.expectRevert(RWAMarketplace.RentalStillActive.selector);\n        market.endRental(3);\n        console.log(\"  Seller tried early end -> REVERTED: RentalStillActive\");\n\n        // Admin override\n        vm.prank(admin);\n        market.endRental(3);\n        console.log(\"  Admin override: rental ended early\");\n\n        // Claim rental escrow\n        vm.warp(block.timestamp + 24 hours + 1);\n        uint256 vBefore = token.balanceOf(vendor);\n        vm.prank(vendor);\n        market.claimEscrow(3);\n        console.log(\"  Vendor claimed:\", (token.balanceOf(vendor) - vBefore) / 1 ether, \"tokens (70% = 700)\");\n\n        vm.prank(companyWallet);\n        market.claimEscrow(3);\n        console.log(\"  CompanyWallet claimed:\", token.balanceOf(companyWallet) / 1 ether, \"tokens (20% = 200)\");\n\n        vm.prank(adminWallet);\n        market.claimEscrow(3);\n        console.log(\"  AdminWallet claimed rental share (10% = 100)\");\n\n        // ================================================================\n        //  PHASE 7: RENTAL — NATURAL EXPIRY\n        // ================================================================\n        console.log(\"\\n========================================\");\n        console.log(\"  PHASE 7: RENTAL NATURAL EXPIRY\");\n        console.log(\"========================================\");\n\n        vm.prank(vendor);\n        market.updatePrice(3, 1200 ether);\n        console.log(\"  Vendor updated rental price to 1200 tokens\");\n\n        vm.prank(tenant);\n        market.startRental(3);\n        console.log(\"  Tenant rented again @ 1200 tokens\");\n\n        (,,, uint256 endsAt2,) = market.rentals(3);\n        vm.warp(endsAt2 + 1);\n        console.log(\"  --- 30 days passed, rental expired ---\");\n\n        vm.prank(vendor);\n        market.endRental(3);\n        console.log(\"  Seller ended rental after expiry: OK\");\n\n        // ================================================================\n        //  PHASE 8: ESCROW DISPUTE — PARTIAL REFUND\n        // ================================================================\n        console.log(\"\\n========================================\");\n        console.log(\"  PHASE 8: ESCROW DISPUTE (PARTIAL REFUND)\");\n        console.log(\"========================================\");\n\n        vm.prank(vendor);\n        market.listNewItem(3000 ether, RWAMarketplace.AssetCategory.DIRECT_SALE, \"gold\", \"GOLD-002\", \"ipfs://gold-002\", 0);\n        console.log(\"  Vendor listed Gold Bar GOLD-002 @ 3000 tokens (listingId=4)\");\n\n        vm.prank(buyer2);\n        market.purchaseItem(4);\n        console.log(\"  Buyer2 purchased -> NFT minted, escrow created (escrowId=5)\");\n\n        vm.prank(admin);\n        market.freezeEscrow(5);\n        console.log(\"  Admin FROZE escrow #5\");\n\n        // Vendor can't claim\n        vm.warp(block.timestamp + 24 hours + 1);\n        vm.prank(vendor);\n        vm.expectRevert(RWAMarketplace.EscrowFrozen.selector);\n        market.claimEscrow(5);\n        console.log(\"  Vendor claim REVERTED: EscrowFrozen\");\n\n        // Partial refund: 2000 to buyer, rest stays\n        uint256 b2Before = token.balanceOf(buyer2);\n        vm.prank(admin);\n        market.resolveEscrow(5, buyer2, 2000 ether);\n        console.log(\"  Admin resolved: 2000 tokens refunded to buyer2\");\n        assertEq(token.balanceOf(buyer2) - b2Before, 2000 ether);\n\n        // Remaining 1000 to vendor\n        vm.prank(admin);\n        market.resolveEscrow(5, vendor, 1000 ether);\n        console.log(\"  Admin resolved: 1000 tokens to vendor (remainder)\");\n\n        // ================================================================\n        //  PHASE 9: ESCROW DISPUTE — UNFREEZE\n        // ================================================================\n        console.log(\"\\n========================================\");\n        console.log(\"  PHASE 9: ESCROW UNFREEZE\");\n        console.log(\"========================================\");\n\n        vm.prank(vendor);\n        market.listNewItem(2000 ether, RWAMarketplace.AssetCategory.DIRECT_SALE, \"gold\", \"GOLD-003\", \"ipfs://gold-003\", 0);\n\n        vm.prank(buyer1);\n        market.purchaseItem(5);\n        console.log(\"  Buyer1 purchased GOLD-003 (escrowId=6)\");\n\n        vm.prank(admin);\n        market.freezeEscrow(6);\n        console.log(\"  Admin froze escrow #6\");\n\n        vm.prank(admin);\n        market.unfreezeEscrow(6);\n        console.log(\"  Admin unfroze escrow #6 (dispute resolved amicably)\");\n\n        // Can now claim normally (unfreeze sets CLAIMABLE, skips 24h)\n        vBefore = token.balanceOf(vendor);\n        vm.prank(vendor);\n        market.claimEscrow(6);\n        console.log(\"  Vendor claimed:\", (token.balanceOf(vendor) - vBefore) / 1 ether, \"tokens (90% of 2000 = 1800)\");\n\n        // ================================================================\n        //  PHASE 10: NFT REDEMPTION\n        // ================================================================\n        console.log(\"\\n========================================\");\n        console.log(\"  PHASE 10: NFT REDEMPTION\");\n        console.log(\"========================================\");\n\n        // Buyer2 owns NFT #2 (from GOLD-002 purchase in phase 8)\n        // Buyer1 owns NFT #3 (from GOLD-003 purchase in phase 9)\n        uint256 nftId = 3; // buyer1's gold NFT\n        console.log(\"  Buyer1 owns NFT #3 (gold, purchasePrice=2000)\");\n\n        uint256 b1TokensBefore = token.balanceOf(buyer1);\n        vm.startPrank(buyer1);\n        token.approve(address(cert), type(uint256).max);\n        cert.redeem(nftId);\n        vm.stopPrank();\n        uint256 feePaid = b1TokensBefore - token.balanceOf(buyer1);\n        console.log(\"  Buyer1 redeemed NFT #3, fee paid:\", feePaid / 1 ether, \"tokens (5% of 2000 = 100)\");\n        assertEq(feePaid, 100 ether);\n\n        vm.prank(vendor);\n        cert.markFulfilled(nftId);\n        console.log(\"  Vendor marked NFT #3 as Fulfilled\");\n\n        vm.prank(admin);\n        cert.burn(nftId);\n        console.log(\"  Admin burned NFT #3 (asset delivered)\");\n\n        // ================================================================\n        //  PHASE 11: NFT DISPUTE\n        // ================================================================\n        console.log(\"\\n========================================\");\n        console.log(\"  PHASE 11: NFT DISPUTE\");\n        console.log(\"========================================\");\n\n        // Buyer2 owns NFT #1 (gold bar from secondary sale)\n        vm.prank(admin);\n        cert.dispute(1);\n        console.log(\"  Admin disputed NFT #1\");\n\n        // Can't transfer while disputed\n        vm.prank(buyer2);\n        vm.expectRevert(RWACertificate.NotTransferable.selector);\n        cert.transferFrom(buyer2, buyer1, 1);\n        console.log(\"  Transfer REVERTED: NotTransferable (disputed)\");\n\n        vm.prank(admin);\n        cert.resolveDispute(1, RWACertificate.AssetStatus.Active);\n        console.log(\"  Admin resolved dispute -> Active\");\n\n        // Can transfer again\n        vm.prank(buyer2);\n        cert.transferFrom(buyer2, buyer1, 1);\n        assertEq(cert.ownerOf(1), buyer1);\n        console.log(\"  Buyer2 transferred NFT #1 back to buyer1: OK\");\n\n        // ================================================================\n        //  PHASE 12: STAKING\n        // ================================================================\n        console.log(\"\\n========================================\");\n        console.log(\"  PHASE 12: STAKING\");\n        console.log(\"========================================\");\n\n        vm.startPrank(staker1);\n        token.approve(address(staking), type(uint256).max);\n        staking.stake(50_000 ether, 1); // 90-day lock, stakeId=0\n        vm.stopPrank();\n        console.log(\"  Staker1 staked 50,000 tokens (90-day lock, tier 1)\");\n        console.log(\"  Total staked:\", staking.totalStaked() / 1 ether);\n\n        // Not yet eligible (need 1 day)\n        assertEq(staking.pendingRevenue(staker1), 0);\n        console.log(\"  Pending revenue (before eligibility): 0\");\n\n        // Advance 1 day + 1 to become eligible\n        vm.warp(block.timestamp + 1 days + 1);\n\n        // Trigger eligibility update\n        vm.prank(staker1);\n        staking.stake(1 ether, 0); // tiny stake to trigger updateRevenue\n        console.log(\"  --- 1 day passed, staker1 now eligible ---\");\n        console.log(\"  Eligible staked:\", staking.eligibleStaked() / 1 ether);\n\n        // Distribute revenue\n        vm.startPrank(admin);\n        token.approve(address(staking), type(uint256).max);\n        staking.notifyRewardAmount(10_000 ether);\n        vm.stopPrank();\n        console.log(\"  Admin distributed 10,000 tokens as revenue\");\n\n        uint256 pending = staking.pendingRevenue(staker1);\n        console.log(\"  Staker1 pending revenue:\", pending / 1 ether, \"tokens\");\n        assertEq(pending, 10_000 ether); // only staker, gets 100%\n\n        vm.prank(staker1);\n        staking.claimRevenue();\n        console.log(\"  Staker1 claimed revenue\");\n        console.log(\"  Staker1 balance:\", token.balanceOf(staker1) / 1 ether, \"tokens\");\n\n        // ================================================================\n        //  PHASE 13: EARLY UNSTAKE (PENALTY)\n        // ================================================================\n        console.log(\"\\n========================================\");\n        console.log(\"  PHASE 13: EARLY UNSTAKE WITH PENALTY\");\n        console.log(\"========================================\");\n\n        // stakeId=0 has 90-day lock, we're only ~2 days in\n        uint256 s1Before = token.balanceOf(staker1);\n        vm.prank(staker1);\n        staking.unstake(0);\n        uint256 received = token.balanceOf(staker1) - s1Before;\n        uint256 penalty = 50_000 ether - received;\n        console.log(\"  Staker1 unstaked 50,000 early\");\n        console.log(\"  Received:\", received / 1 ether, \"tokens\");\n        console.log(\"  Penalty:\", penalty / 1 ether, \"tokens (10% = 5000)\");\n        assertEq(penalty, 5000 ether);\n        assertEq(token.balanceOf(marketing), penalty); // penalty goes to penaltyReceiver\n\n        // ================================================================\n        //  PHASE 14: PAUSE / UNPAUSE\n        // ================================================================\n        console.log(\"\\n========================================\");\n        console.log(\"  PHASE 14: PAUSE / UNPAUSE\");\n        console.log(\"========================================\");\n\n        vm.prank(admin);\n        market.pause();\n        console.log(\"  Marketplace PAUSED\");\n\n        vm.prank(vendor);\n        vm.expectRevert();\n        market.listNewItem(100 ether, RWAMarketplace.AssetCategory.DIRECT_SALE, \"x\", \"X\", \"u\", 0);\n        console.log(\"  Listing REVERTED: paused\");\n\n        vm.prank(admin);\n        market.unpause();\n        console.log(\"  Marketplace UNPAUSED\");\n\n        vm.prank(vendor);\n        market.listNewItem(100 ether, RWAMarketplace.AssetCategory.DIRECT_SALE, \"gold\", \"G-FINAL\", \"ipfs://final\", 0);\n        console.log(\"  Listing succeeded after unpause\");\n\n        // ================================================================\n        //  PHASE 15: RESCUE TOKENS\n        // ================================================================\n        console.log(\"\\n========================================\");\n        console.log(\"  PHASE 15: RESCUE TOKENS\");\n        console.log(\"========================================\");\n\n        // Accidentally send tokens to marketplace\n        vm.prank(buyer1);\n        token.transfer(address(market), 500 ether);\n        console.log(\"  Buyer1 accidentally sent 500 tokens to marketplace\");\n\n        uint256 adminBefore = token.balanceOf(admin);\n        vm.prank(admin);\n        market.rescueTokens(address(token), 500 ether);\n        assertEq(token.balanceOf(admin) - adminBefore, 500 ether);\n        console.log(\"  Admin rescued 500 tokens\");\n\n        // ================================================================\n        //  PHASE 16: DELIST\n        // ================================================================\n        console.log(\"\\n========================================\");\n        console.log(\"  PHASE 16: DELIST\");\n        console.log(\"========================================\");\n\n        // Vendor delists the item from phase 14\n        vm.prank(vendor);\n        market.delistItem(6);\n        console.log(\"  Vendor delisted listingId=6\");\n\n        vm.prank(buyer1);\n        vm.expectRevert(RWAMarketplace.ListingNotActive.selector);\n        market.purchaseItem(6);\n        console.log(\"  Purchase REVERTED: ListingNotActive\");\n\n        // ================================================================\n        //  FINAL SUMMARY\n        // ================================================================\n        console.log(\"\\n========================================\");\n        console.log(\"  FINAL BALANCE SUMMARY\");\n        console.log(\"========================================\");\n        console.log(\"  Admin:         \", token.balanceOf(admin) / 1 ether);\n        console.log(\"  Vendor:        \", token.balanceOf(vendor) / 1 ether);\n        console.log(\"  Buyer1:        \", token.balanceOf(buyer1) / 1 ether);\n        console.log(\"  Buyer2:        \", token.balanceOf(buyer2) / 1 ether);\n        console.log(\"  Tenant:        \", token.balanceOf(tenant) / 1 ether);\n        console.log(\"  Staker1:       \", token.balanceOf(staker1) / 1 ether);\n        console.log(\"  AdminWallet:   \", token.balanceOf(adminWallet) / 1 ether);\n        console.log(\"  CompanyWallet: \", token.balanceOf(companyWallet) / 1 ether);\n        console.log(\"  Marketing:     \", token.balanceOf(marketing) / 1 ether);\n        console.log(\"  Marketplace:   \", token.balanceOf(address(market)) / 1 ether);\n        console.log(\"  Staking:       \", token.balanceOf(address(staking)) / 1 ether);\n        console.log(\"  Total Supply:  \", token.totalSupply() / 1 ether);\n        console.log(\"========================================\");\n        console.log(\"  ALL PHASES COMPLETE\");\n        console.log(\"========================================\");\n\n        // Verify total supply unchanged (no mint/burn of tokens)\n        assertEq(token.totalSupply(), INITIAL_SUPPLY);\n    }\n}\n",
                "summary": "Create comprehensive end-to-end flow test covering all 16 phases of the RWA ecosystem"
              }
            }
          ]
        }
